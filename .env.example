# Brauzer (admin panel) uchun ommaviy kalitlar. service_role kalitni bu faylga QO'YMANG.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Faqat Vercel (admin panel loyihasi) -> Settings -> Environment Variables ichida: ---
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_xxx
# SUPABASE_SERVICE_ROLE_KEY=...            (faqat server; hech qachon frontendga/repoga qo'ymang)
# GITHUB_WORKFLOW_TOKEN=github_pat_...     (sayt repozitoriyasi uchun: Actions: Read and write, Contents: Read)
# GITHUB_SITE_REPOSITORY=AsliddinXoliqulov/Azizbek_avto_test_ilova_sayt   (ixtiyoriy; shu qiymat standart)
# GITHUB_SITE_BRANCH=main                                                  (ixtiyoriy)
